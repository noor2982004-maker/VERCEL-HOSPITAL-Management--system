# Copy to .env for local development. Placeholders only: never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- Database & auth ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=7d

# --- Email (OTP) ---
EMAIL_USER=<sender@example.com>
EMAIL_PASS=<app-password>

# --- Google sign-in (comma-separated client ids) ---
GOOGLE_CLIENT_ID=<google-oauth-client-id>

# --- Cloudinary uploads ---
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# --- Misc ---
# Base of the doctor upload links (${BACKEND_URL}/doctor-upload); the route lives under /api/up.
# Vercel (production): https://vercel-hospital-management-system.vercel.app/api/up
BACKEND_URL=http://localhost:3000/api/up
CRON_SECRET=<random-secret-for-vercel-cron>
PORT=3000

# --- Devora Medical AI (Modal). Server-side only: never ship the token to the app. ---
DEVORA_AI_URL=https://mahmoudbadr238--devora-medical-ai-api.us-east.modal.run
DEVORA_AI_TOKEN=<modal-bearer-token>
# How long POST /api/ai/chat waits for a queued answer before returning 202 pending.
# Must stay well under the Vercel function's max duration (see BACKEND_AI_INTEGRATION.md).
DEVORA_AI_WAIT_MS=25000
